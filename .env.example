# ---------------------------------------------------------------------------
# Apple account
# ---------------------------------------------------------------------------
# The Apple ID whose iCloud Drive this server exposes.
ICLOUD_APPLE_ID=you@example.com

# The account's REAL password. An app-specific password does NOT work for
# iCloud Drive — Apple only honours those for Mail, Contacts, Calendar and
# Reminders. It is used once, during sign-in, to mint a session; after that the
# trust token in ICLOUD_SESSION_DIR is what keeps the server working, and you
# can safely blank this line out.
ICLOUD_PASSWORD=

# Where the Apple session and trust token are written. Must be a persistent
# volume, or each restart needs a fresh two-factor code.
ICLOUD_SESSION_DIR=/data/icloud-session

# ---------------------------------------------------------------------------
# Scope and safety limits
# ---------------------------------------------------------------------------
# Confine every tool to one folder. Strongly recommended: with this set, Claude
# cannot see or touch anything else in the Drive. Leave blank for full access.
ICLOUD_ROOT_PATH=/Claude

# Refuse all writes, renames, and deletions.
ICLOUD_READ_ONLY=false

# Largest single file to read or write, in bytes (default 25 MiB).
ICLOUD_MAX_FILE_BYTES=26214400

# ---------------------------------------------------------------------------
# Remote access (mode: http)
# ---------------------------------------------------------------------------
# The public HTTPS base URL of this server. OAuth metadata is built from it, so
# it must match what Claude connects to exactly, with no trailing slash.
PUBLIC_URL=https://icloud-mcp.example.com

# Password you type on the consent screen when connecting Claude. This is NOT
# your Apple password. Generate one: openssl rand -base64 24
MCP_GATE_PASSWORD=

# Optional bearer token for clients that cannot run an OAuth flow, such as
# Claude Code's own config. Generate one: openssl rand -hex 32
MCP_STATIC_TOKEN=

# Guards /admin/login and /status. Required to re-authenticate from a browser.
# Generate one: openssl rand -hex 32
ADMIN_TOKEN=

HOST=0.0.0.0
PORT=8000
